# App
APP_NAME=hr-policy-rag
ENV=dev
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# DBs (host ports remapped: local Postgres on 5432, another Redis on 6379)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/hr_rag
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hr_policies
REDIS_URL=redis://localhost:6380/0

# Auth (used in Feature 3, defined now so config is stable)
JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# Models (used in Phase 1+)
EMBED_PROVIDER=huggingface
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_DIM=1024
HF_TOKEN=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMP=0.1
OPENAI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
RERANK_MODEL=rerank-english-v3.0
RERANK_THRESHOLD=0.3
RERANK_TOP_N=5

# Cache (Feature 11)
CACHE_TTL_STANDARD=86400
CACHE_TTL_BENEFITS=3600
CACHE_SIM_THRESHOLD=0.95

# RAG tuning
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=10
TOP_K_RERANK=5
SCORE_THRESHOLD=0.5

# Observability (Phase 4)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-rag-dev

